employees (id, first_name, last_name, department_id, salary, hire_date, manager_id)
departments (id, name, location)
projects (id, name, department_id, budget, start_date)
employee_projects (employee_id, project_id, role, hours_worked)


Her departmandaki çalışan sayısını bul (GROUP BY).

Select Count(e.id) , e.depertman_id From employess e
Group by (e.depertman_id)



Her departmanın ortalama maaşını hesapla.

Select AVG(e.salary) , e.depertamna_id From employess e
Group by e.depertman_id




Her departmanın toplam maaş giderini bul (SUM).

Select Sum(e.salary) , e.depertman_id From employess e
Group by (e.depertman_id)



Çalışan sayısı 5'ten fazla olan departmanları listele (HAVING).

Select d.name , count(d.id) From depermans d
Innerjoin  employess e  on d._id = e.depertmans_id
Group by(d.name)
having Count(e.id) > 5






Ortalama maaşı 8000'den yüksek olan departmanları getir (HAVING).

Select d.name , AVG(e.salary) From depertmans d
InnerJoin Employess e on e.depertman_id = d.id
Group By(d.name)
having AVG(e.salary) > 8000





Her yöneticinin (manager_id) kaç çalışanı olduğunu bul.

Select Count(e.id) , e.manager_id From employess
Group By (e.manager_id)




En çok çalışana sahip ilk 3 departmanı getir.

Select Count(e.id) as calisan , d.name From depertmans
InnerJoin employess e on e.depertmans_id = d.id
Group By(d.name)
Order By(calisan) DESC
