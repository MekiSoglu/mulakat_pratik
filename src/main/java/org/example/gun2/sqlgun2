Select e.name , d.name From employess e
ınnerJoin Depertmans d on d.id = e.depertmans_id



Maaşı, kendi departmanının ortalama maaşından yüksek olan çalışanları bul (subquery ile).

Select e.name , s.salary , AVG(e.salary), d.name From employess e
InnerJoin Depertmans d on d.id = e.depertmans_id
group By (d.name)
Having AVG(e.salary) < e.salary



En yüksek maaşa sahip çalışanı(ları) bul (subquery ile, MAX kullanarak).

Select e.name From employess
where e.salary = (Select Max(sum.salary) From employess e )





Her departmanda kaç farklı proje yürütüldüğünü bul (departments + projects JOIN + GROUP BY).

Select d.name , p.name , COUNT(p.name) From depertman d
InnerJoin Project p on p.depertman_id = d.id
Group By (d.name)



